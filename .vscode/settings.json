{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdf",
      "command": "latexmk",
      "args": ["-cd", "-pdf", "-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
    },
    {
      "name": "latexmk-xe",
      "command": "latexmk",
      "args": ["-cd", "-xelatex", "-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
    },
    {
      "name": "latexmk-lua",
      "command": "latexmk",
      "args": ["-cd", "-lualatex", "-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {"name": "latexmk (pdfLaTeX)", "tools": ["latexmk-pdf"]},
    {"name": "latexmk (XeLaTeX)", "tools": ["latexmk-xe"]},
    {"name": "latexmk (LuaLaTeX)", "tools": ["latexmk-lua"]}
  ]
}
